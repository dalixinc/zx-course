1 REM S=FRAMES just before a timed call
2 REM C=frames for 10 CLS (example 13)
3 REM P=frames for 100 pnum prints (10)
4 REM R=frames for 100 ROM prints (11)
5 REM Q=frames for 100 AT alone (12)
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE EXAMPLES"
40 LOAD ""CODE
50 LET S=PEEK 23672+256*PEEK 23673: RANDOMIZE USR 51300: LET C=PEEK 23672+256*PEEK 23673-S
60 CLS : PRINT "STEP 6: EXAMPLE, RESULT"
70 PRINT "1 RAMTOP    ";USR 50100
80 PRINT "2 ATTR P    ";USR 50200
90 PRINT "3 RST 16    ";: RANDOMIZE USR 50300: PRINT
100 PRINT "4 PRINT-FP  ";: RANDOMIZE USR 50400: PRINT
110 PRINT "5 OUT-NUM-1 ";: RANDOMIZE USR 50500: PRINT
120 PRINT "6 FREE      ";USR 50600
130 PRINT "7 PSTR      ";: RANDOMIZE USR 50700: PRINT
140 PRINT "8 PNUM      ";: RANDOMIZE USR 50800: PRINT
150 PRINT "9 TABLE     ";: RANDOMIZE USR 50900: PRINT
160 LET S=PEEK 23672+256*PEEK 23673: RANDOMIZE USR 51000: LET P=PEEK 23672+256*PEEK 23673-S
170 LET S=PEEK 23672+256*PEEK 23673: RANDOMIZE USR 51100: LET R=PEEK 23672+256*PEEK 23673-S
180 LET S=PEEK 23672+256*PEEK 23673: RANDOMIZE USR 51200: LET Q=PEEK 23672+256*PEEK 23673-S
190 PRINT AT 10,0;"10 100 PNUM    ";P;" FRAMES"
200 PRINT "11 100 ROM     ";R;" FRAMES"
210 PRINT "12 100 AT ONLY ";Q;" FRAMES"
220 PRINT "13 10 CLS      ";C;" FRAMES"
230 STOP
