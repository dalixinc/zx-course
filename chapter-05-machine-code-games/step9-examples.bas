1 REM R=a screen row to test
2 REM C=a screen column to test
3 REM A=example 1's answer, the alive byte or 0
4 REM I=counts the cells in the DATA
5 REM J=a block row for example 2
6 REM K=an invader in that row
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 POKE 50000,8: POKE 50001,1
60 PRINT "ROW COL INVAT IROW ICOL"
70 RESTORE 500
80 FOR I=1 TO 8
90 READ R,C: GO SUB 300
100 NEXT I
110 POKE 50300+31,0
120 PRINT "INVADER 3,7 KILLED:"
130 LET R=7: LET C=22: GO SUB 300
140 POKE 50300+31,1
150 PRINT '"ALIVEAT: IROW ICOL ADDRESS"
160 RESTORE 600
170 FOR I=1 TO 4
180 READ J,K: POKE 50004,J: POKE 50005,K
190 PRINT TAB 9;J;TAB 14;K;TAB 19;USR 50200
200 NEXT I
210 STOP
300 POKE 50002,R: POKE 50003,C: POKE 50004,9: POKE 50005,9
310 LET A=USR 50100
320 PRINT R;TAB 4;C;TAB 8;A;TAB 14;PEEK 50004;TAB 19;PEEK 50005
330 RETURN
500 DATA 1,8,7,22,3,14,2,8,1,9,0,8,9,8,1,24
600 DATA 0,0,0,7,1,0,3,7
