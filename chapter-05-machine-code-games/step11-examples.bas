1 REM N=counts the cells in the DATA
2 REM R=a screen row to test
3 REM C=a screen column to test
4 REM K=example 2's answer
5 REM I=a byte of the table
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 FOR I=0 TO 31: POKE 50500+I,1: NEXT I
60 POKE 50000,8: POKE 50001,1
70 PRINT "BLOCK AT BX=8, BY=1"
80 PRINT "ALIVE AT THE START: ";USR 50100
90 PRINT '"ROW COL KILLED IROW ICOL ALIVE"
100 RESTORE 500
110 FOR N=1 TO 7
120 READ R,C: POKE 50002,R: POKE 50003,C: POKE 50004,9: POKE 50005,9
130 LET K=USR 50200
140 PRINT R;TAB 4;C;TAB 8;K;TAB 15;PEEK 50004;TAB 20;PEEK 50005;TAB 25;USR 50100
150 NEXT N
160 PRINT '"ROW 3 OF THE TABLE: ";
170 FOR I=0 TO 7: PRINT PEEK (50500+24+I);: NEXT I
180 STOP
500 DATA 7,16,7,16,7,15,0,8,1,8,1,22,21,16
