1 REM V=keys read by example 1 or 2, then printed in binary
2 REM K=the key mask, bit 0 P, 1 O, 2 Space, 3 Q
3 REM N=how many bits GO SUB 800 prints
4 REM J=counts the bits
5 REM D=one bit, 0 or 1, and USR 50300's answer
6 REM B$=the bits, as text
7 REM F=frames for 10000 calls of the mask routine
8 REM E=frames for 500 empty passes of a FOR loop
9 REM G=frames for 500 INKEY$ reads
10 REM U=frames for 500 calls of example 2 from BASIC
11 REM I=the FOR loop counter
12 REM K$=the key INKEY$ gives
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 PRINT "HOLD KEYS. Q ENDS THE WATCH"
60 PRINT AT 2,0;"ALL ROWS (0)         ";
70 POKE 50000,0: LET V=USR 50100: LET N=5: GO SUB 800
80 PRINT AT 3,0;"ROWS 223+127 (95)    ";
90 POKE 50000,95: LET V=USR 50100: GO SUB 800
100 PRINT AT 4,0;"MASK Q,SPACE,O,P     ";
110 LET K=USR 50200: LET V=K: LET N=4: GO SUB 800
120 PRINT AT 5,0;"INKEY$ """;INKEY$;"""  "
130 IF K<8 THEN GO TO 60
140 PRINT AT 7,0;"TIMING..."
150 POKE 23672,0: POKE 23673,0
160 LET D=USR 50300
170 LET F=PEEK 23672+256*PEEK 23673
180 POKE 23672,0: POKE 23673,0
190 FOR I=1 TO 500: NEXT I
200 LET E=PEEK 23672+256*PEEK 23673
210 POKE 23672,0: POKE 23673,0
220 FOR I=1 TO 500: LET K$=INKEY$: NEXT I
230 LET G=PEEK 23672+256*PEEK 23673
240 POKE 23672,0: POKE 23673,0
250 FOR I=1 TO 500: LET K=USR 50200: NEXT I
260 LET U=PEEK 23672+256*PEEK 23673
270 PRINT AT 7,0;"10000 MASKS: ";F;" FRAMES"
280 PRINT "T-STATES A MASK, LOOP IN: ";INT (F*69888/10000)
290 PRINT "500 EMPTY FOR PASSES: ";E
300 PRINT "500 LET K$=INKEY$:    ";G
310 PRINT "500 LET K=USR 50200:  ";U
320 PRINT "FRAMES AN INKEY$:     ";(G-E)/500
330 PRINT "FRAMES A USR MASK:    ";(U-E)/500
340 STOP
800 LET B$=""
810 FOR J=1 TO N: LET D=V-2*INT (V/2): LET B$=STR$ D+B$: LET V=INT (V/2): NEXT J
820 PRINT B$
830 RETURN
