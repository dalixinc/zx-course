1 REM N=counts the cells in the DATA
2 REM R=a screen row to test
3 REM C=a screen column to test
4 REM K=a USR answer
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 FOR N=0 TO 23: POKE 50500+N,3: NEXT N
60 PRINT "ROW COL  MAP SHY SHX"
70 RESTORE 500
80 FOR N=1 TO 9
90 READ R,C: POKE 50000,R: POKE 50001,C: POKE 50002,9: POKE 50003,9
100 LET K=USR 50100
110 PRINT R;TAB 4;C;TAB 9;K;TAB 15;PEEK 50002;TAB 19;PEEK 50003
120 NEXT N
130 PRINT '"CHIP 19,4 FOUR TIMES:"
140 POKE 50000,19: POKE 50001,4
150 FOR N=1 TO 4: PRINT USR 50200;" ";: NEXT N
160 PRINT '"CHIP 18,4 ONCE: ";: POKE 50000,18: PRINT USR 50200
170 PRINT "CHIPS ";PEEK 50004
180 STOP
500 DATA 18,3,18,5,19,4,18,6,19,27,19,29,17,4,18,30,18,2
