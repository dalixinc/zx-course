1 REM N=a note number, 0 to 3
2 REM V=what USR gave back
3 REM D=a delay count
4 REM C=cycles
5 REM F=the note's frequency
6 REM A$=the note's name
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 PRINT "NOTE  DELAY CYCLES  HERTZ"
70 RESTORE 500
80 FOR N=0 TO 3: READ A$,D,C
90 LET F=3500000/(52*D+110)
100 PRINT AT 2+N,0;A$;TAB 6;D;TAB 13;C;TAB 20;INT (F+.5)
110 NEXT N
120 PRINT AT 8,0;"EX 1, THEN THE FOUR NOTES (EX 2)"
125 POKE 50000,255: POKE 50001,0: POKE 50002,3: LET V=USR 50100: PAUSE 25
130 FOR N=0 TO 3: POKE 50003,N: LET V=USR 50200: PAUSE 25: NEXT N
140 PRINT AT 10,0;"BORDER 2, THEN A NOTE (EX 2)"
150 BORDER 2: PAUSE 50: POKE 50003,0: LET V=USR 50200: PAUSE 50
160 PRINT AT 12,0;"BORDER COLOUR (EX 4): ";USR 50400
170 PRINT AT 14,0;"NOW A NOTE THAT LEAVES THE"
180 PRINT "BORDER BITS AT 0 (EX 3)"
190 POKE 50000,255: POKE 50001,0: POKE 50002,3
200 LET V=USR 50300: PAUSE 100
210 PRINT AT 17,0;"BORDER COLOUR (EX 4): ";USR 50400
220 STOP
500 DATA "BAT",255,3,"WALL",62,10,"BRICK",126,5,"MISS",512,1
