1 REM N=loop counter, 1 to 8
2 REM H=a half-row, the port's top byte
3 REM K$=the keys of that half-row
4 REM V=the bits IN read
5 REM Z$=V in binary, 5 digits
6 REM D=loop counter for the digits
7 REM W=what CPL gave
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 PRINT "HALF BITS  KEYS, BIT 4 TO 0  CPL"
70 PRINT AT 11,0;"HOLD KEYS DOWN AND WATCH"
80 PRINT AT 12,0;"CAPS SHIFT AND SPACE TO BREAK"
100 RESTORE 500: FOR N=1 TO 8: READ H,K$
110 POKE 50000,H: LET V=USR 50100: LET W=USR 50200
120 LET Z$="": FOR D=1 TO 5: LET Z$=STR$ (V-2*INT (V/2))+Z$: LET V=INT (V/2): NEXT D
130 PRINT AT N,0;H;TAB 5;Z$;TAB 12;K$;TAB 29;W;"  "
140 NEXT N
150 PRINT AT 10,0;"INKEY$ """;INKEY$;"""  "
160 GO TO 100
500 DATA 254,"V C X Z CAPS",253,"G F D S A"
510 DATA 251,"T R E W Q",247,"5 4 3 2 1"
520 DATA 239,"6 7 8 9 0",223,"Y U I O P"
530 DATA 191,"H J K L ENTER",127,"B N M SYM SPACE"
