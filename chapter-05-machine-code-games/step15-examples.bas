1 REM N=counts the DATA, then the shifts
2 REM K=a USR answer
3 REM Y=a pixel line
4 REM C=a byte column
5 REM F=frames for 510 draws shifted at run time
6 REM G=frames for 510 draws from the shifted copies
20 CLEAR 49999
30 LOAD ""CODE
40 BORDER 0: PAPER 0: INK 7: CLS
50 RANDOMIZE USR 50500
52 POKE 50000,0: POKE 50002,7: POKE 50003,255
54 POKE 23672,0: POKE 23673,0: LET K=USR 50200: LET K=USR 50200: LET F=PEEK 23672+256*PEEK 23673
56 POKE 23672,0: POKE 23673,0: LET K=USR 50300: LET K=USR 50300: LET G=PEEK 23672+256*PEEK 23673
60 PRINT "Y   COL ADDRESS"
70 RESTORE 500
80 FOR N=1 TO 6: READ Y,C: POKE 50000,Y: POKE 50001,C: PRINT Y;TAB 4;C;TAB 8;USR 50100: NEXT N
90 PRINT "510 DRAWS: ";F;" AND ";G;" FRAMES"
100 POKE 50001,18
110 FOR Y=64 TO 159: POKE 50000,Y: LET K=USR 50100
120 FOR C=0 TO 13: POKE K+C,85+85*(Y-2*INT (Y/2)): NEXT C: NEXT Y
130 POKE 50003,1
140 FOR N=0 TO 7: POKE 50000,64+12*N
150 POKE 50002,16+N: LET K=USR 50200
160 POKE 50002,80+N: LET K=USR 50300
170 POKE 50002,152+N: LET K=USR 50200
180 POKE 50002,208+N: LET K=USR 50400
190 NEXT N
200 PRINT AT 20,0;"RUN TIME COPIES   XOR     MASK"
210 STOP
500 DATA 0,0,1,0,8,0,64,0,168,15,191,31
