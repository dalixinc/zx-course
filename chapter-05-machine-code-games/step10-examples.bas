1 REM E=example 1's answer, lm+256*rm
2 REM I=a block row
3 REM J=an invader in the row
4 REM R=a screen row to test
5 REM C=a screen column to test
6 REM N=counts the cells in the DATA
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 PRINT "EDGES       LM  RM"
60 LET E=USR 50100: PRINT "ALL ALIVE";TAB 12;E-256*INT (E/256);TAB 16;INT (E/256)
70 FOR I=0 TO 3: POKE 50500+8*I,0: POKE 50500+8*I+7,0: NEXT I
80 LET E=USR 50100: PRINT "NO COLS 0,7";TAB 12;E-256*INT (E/256);TAB 16;INT (E/256)
90 POKE 50500+8*2+3,1: FOR I=0 TO 3: FOR J=0 TO 7: IF J<>3 THEN POKE 50500+8*I+J,0
100 NEXT J: NEXT I
110 LET E=USR 50100: PRINT "ONLY COL 3";TAB 12;E-256*INT (E/256);TAB 16;INT (E/256)
120 FOR I=0 TO 31: POKE 50500+I,0: NEXT I
130 PRINT "NONE ALIVE: ";USR 50100
140 FOR I=0 TO 31: POKE 50500+I,1: NEXT I
150 PRINT '"INVAT, BX=254 (-2), BY=1"
160 POKE 50000,254: POKE 50001,1
170 PRINT "ROW COL INVAT IROW ICOL"
180 RESTORE 500
190 FOR N=1 TO 5
200 READ R,C: POKE 50002,R: POKE 50003,C: POKE 50004,9: POKE 50005,9
210 PRINT R;TAB 4;C;TAB 8;USR 50200;TAB 14;PEEK 50004;TAB 19;PEEK 50005
220 NEXT N
230 STOP
500 DATA 1,0,1,12,1,1,1,14,1,31
