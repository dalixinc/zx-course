1 REM V=the value tested
2 REM I=counts the values in the DATA
3 REM A=example 1's answer, INC A
4 REM B=example 2's answer, CP 255
5 REM C=example 3's answer, the count
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 PRINT "VAL   INC A   CP 255"
60 RESTORE 500
70 FOR I=1 TO 5
80 READ V: POKE 50000,V
90 LET A=USR 50100: LET B=USR 50200
100 PRINT V;TAB 6;A;TAB 14;B
110 NEXT I
120 PRINT ''"CALL NZ,BUMP, COUNT FROM 0"
130 POKE 50001,0
140 RESTORE 500
150 FOR I=1 TO 5
160 READ V: POKE 50000,V
170 LET C=USR 50300
180 PRINT "VAL ";V;TAB 9;"COUNT ";C
190 NEXT I
200 STOP
500 DATA 0,1,254,255,128
