1 REM N=counts the numbers in the DATA, then the waves
2 REM V=a number to print
3 REM D=how many digits to print it in
4 REM K=a USR answer
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 POKE 50000,0: POKE 50001,0: LET K=USR 50200
60 RESTORE 500
70 FOR N=1 TO 5: READ V,D
80 POKE 50000,N: POKE 50001,0: POKE 50002,V-256*INT (V/256): POKE 50003,INT (V/256): POKE 50004,D
90 LET K=USR 50100: PRINT AT N,14;V;" IN ";D
100 NEXT N
110 PRINT AT 7,0;"WAVE  BY  MSPEED"
120 POKE 50006,1: POKE 50007,25
130 FOR N=1 TO 10: POKE 50005,N: LET K=USR 50300
140 PRINT N;TAB 6;INT (K/256);TAB 10;K-256*INT (K/256): NEXT N
150 POKE 50006,12: POKE 50005,3: LET K=USR 50300
160 PRINT "BFIRST 12, WAVE 3: BY ";INT (K/256)
170 STOP
500 DATA 0,5,640,5,65535,5,7,2,3,1
