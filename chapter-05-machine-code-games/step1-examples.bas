1 REM V=a value to POKE into 50000
2 REM S=a step to POKE into 50001
3 REM R=a row for example 6
4 REM C=a column for example 6
5 REM N=loop counter
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 PRINT "1 NEG"
70 RESTORE 500: FOR N=1 TO 3: READ V: POKE 50000,V
80 PRINT "  NEG ";V;" = ";USR 50100: NEXT N
90 PRINT "2 ADD A,(HL)"
100 RESTORE 510: FOR N=1 TO 3: READ V,S: POKE 50000,V: POKE 50001,S
110 PRINT "  ";V;" + ";S;" = ";USR 50200: NEXT N
120 PRINT "3 CP 22 (1 IF 0 TO 21)"
130 RESTORE 520: FOR N=1 TO 4: READ V: POKE 50000,V
140 PRINT "  ";V;" GIVES ";USR 50300: NEXT N
150 PRINT "4 BIT 5,(HL) AND 5 RES 5,(HL)"
160 RESTORE 530: FOR N=1 TO 2: READ V: POKE 50000,V
170 PRINT "  ";V;": BIT ";USR 50400;" RES ";USR 50500: NEXT N
180 PRINT "6 CELL ADDRESS"
190 RESTORE 540: FOR N=1 TO 4: READ R,C: POKE 50002,R: POKE 50003,C
200 PRINT "  ROW ";R;" COL ";C;" = ";USR 50600: NEXT N
210 STOP
500 DATA 1,255,0
510 DATA 5,1,5,255,0,255
520 DATA 0,21,22,255
530 DATA 255,16
540 DATA 0,0,5,5,8,0,21,31
