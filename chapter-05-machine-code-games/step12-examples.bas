1 REM N=counts
2 REM K=a USR answer
3 REM I=a block row
4 REM J=a block column
5 REM R=the shot's row to test
6 REM U=the bomb's row to test
7 REM C=the shot's column to test
8 REM D=the bomb's column to test
20 CLEAR 49999
30 LOAD ""CODE
40 CLS
50 FOR N=0 TO 31: POKE 50600+N,1: NEXT N
60 POKE 50000,1
70 PRINT "16 COLUMNS FROM SEED 1:"
80 FOR N=1 TO 16: PRINT USR 50100;" ";: NEXT N
90 PRINT ''"DROPS FROM (COLUMN, ROW):"
100 PRINT "ALL ALIVE: ";: GO SUB 400
110 FOR I=0 TO 3: FOR J=0 TO 5: POKE 50600+8*I+J,0: NEXT J: NEXT I
120 PRINT "COLS 0-5 GONE: ";: GO SUB 400
130 FOR I=1 TO 3: POKE 50600+8*I+6,0: NEXT I
140 PRINT "COL 6 ROW 0: ";: GO SUB 400
150 FOR N=0 TO 31: POKE 50600+N,0: NEXT N
160 PRINT "NONE ALIVE: ";USR 50200
170 PRINT '"SHOT  BOMB  MET"
180 RESTORE 500
190 FOR N=1 TO 7
200 READ R,C,U,D: POKE 50003,R: POKE 50005,C: POKE 50004,U: POKE 50006,D
210 PRINT R;",";C;TAB 6;U;",";D;TAB 12;USR 50300
220 NEXT N
230 STOP
400 FOR N=1 TO 4: LET K=USR 50200: PRINT INT (K-256*INT (K/256));",";INT (K/256);" ";: NEXT N
410 PRINT : RETURN
500 DATA 10,5,10,5,11,5,10,5,12,5,10,5,9,5,10,5,11,6,10,5,255,5,10,5,11,5,255,5
