1 REM N=loop counter
2 REM V=a value from the code
3 REM P=the value before it
4 REM L=how many values were under 51
5 REM Q=how many followed another under 51
6 REM A=entry address, 50500 or 50100
7 REM T=count of calls in a period
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 PRINT "LFSR FROM SEED 1, FIRST 8"
70 POKE 50000,1: PRINT "ONE SHIFT:"
80 FOR N=1 TO 8: PRINT USR 50500;" ";: NEXT N
90 PRINT : PRINT "EIGHT SHIFTS:"
100 POKE 50000,1: FOR N=1 TO 8: PRINT USR 50100;" ";: NEXT N
110 PRINT : PRINT
120 PRINT "CALLS BEFORE THE SEED RETURNS"
130 POKE 50000,1: LET T=0
140 LET V=USR 50100: LET T=T+1: IF V<>1 THEN GO TO 140
150 PRINT "EIGHT SHIFTS: ";T
160 POKE 50000,1: LET T=0
170 LET V=USR 50500: LET T=T+1: IF V<>1 THEN GO TO 170
180 PRINT "ONE SHIFT:    ";T
190 PRINT : PRINT "OVER ONE PERIOD, UNDER 51"
200 PRINT "AND A SECOND UNDER 51 AFTER IT"
210 LET A=50500: GO SUB 400: PRINT "ONE SHIFT:    ";L;" AND ";Q
220 LET A=50100: GO SUB 400: PRINT "EIGHT SHIFTS: ";L;" AND ";Q
230 PRINT : PRINT "PRESS A KEY": PAUSE 0
240 CLS
250 PRINT "LD A,R FROM BASIC, 12 TIMES"
260 FOR N=1 TO 12: PRINT USR 50200;" ";: NEXT N
270 PRINT : PRINT : PRINT "LD A,R IN A TIGHT LOOP, 16"
280 LET V=USR 50400
290 FOR N=0 TO 15: PRINT PEEK (50700+N);" ";: NEXT N
300 PRINT : PRINT : PRINT "FRAMES, BASIC, 12 TIMES"
310 FOR N=1 TO 12: PRINT USR 50300;" ";: NEXT N
320 STOP
400 POKE 50000,1: LET L=0: LET Q=0: LET P=255
410 FOR N=1 TO 255
420 LET V=USR A
430 IF V<51 THEN LET L=L+1: IF P<51 THEN LET Q=Q+1
440 LET P=V
450 NEXT N
460 RETURN
