1 REM R=row to print at
2 REM C=column to print at
3 REM K=character code
4 REM V=what USR gave back
5 REM I=loop counter
6 REM N=the number to print
7 REM F=FRAMES at the end of a timing loop
8 REM A=the address of the code being timed
9 REM A$=the name of the code being timed
10 REM J=which code is being timed
11 CLEAR 49999
20 BORDER 1: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 LET R=2: LET C=2: LET K=65
70 POKE 50000,R: POKE 50001,C: POKE 50002,K
80 LET V=USR 50100
90 POKE 50000,4: POKE 50002,66: LET V=USR 50500
100 POKE 50000,4: POKE 50001,4: POKE 50002,67: LET V=USR 50100
110 LET V=USR 50200
120 LET N=1234: POKE 50003,N-256*INT (N/256): POKE 50004,INT (N/256)
130 POKE 50000,6: POKE 50001,2: LET V=USR 50300
140 LET N=450: POKE 50003,N-256*INT (N/256): POKE 50004,INT (N/256): POKE 50005,2
150 LET V=USR 50400
155 POKE 50000,21: POKE 50001,24
160 PRINT AT 8,0;"TIMES FOR 100 CALLS, IN FRAMES"
170 RESTORE 500
180 FOR J=1 TO 6
190 READ A$,A
200 POKE 23672,0: POKE 23673,0
210 FOR I=1 TO 100: LET V=USR A: NEXT I
220 LET F=PEEK 23672+256*PEEK 23673
230 PRINT AT 9+J,0;A$;TAB 16;F
240 NEXT J
250 POKE 23672,0: POKE 23673,0
252 FOR I=1 TO 100: NEXT I
254 LET F=PEEK 23672+256*PEEK 23673
256 PRINT AT 16,0;"EMPTY LOOP";TAB 16;F
258 POKE 23672,0: POKE 23673,0
260 FOR I=1 TO 100: PRINT AT 21,28;"A": NEXT I
270 LET F=PEEK 23672+256*PEEK 23673
280 PRINT AT 17,0;"BASIC CHAR";TAB 16;F
290 POKE 23672,0: POKE 23673,0
300 FOR I=1 TO 100: PRINT AT 0,1;"SCORE "+STR$ N;AT 0,22;"LIVES 2": NEXT I
310 LET F=PEEK 23672+256*PEEK 23673
320 PRINT AT 18,0;"BASIC STATUS";TAB 16;F
330 STOP
500 DATA "NOTHING",50700,"ROM CHAR",50100,"OWN CHAR",50500
510 DATA "STRING",50200,"NUMBER",50300,"STATUS",50400

