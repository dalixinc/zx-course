1 REM R=a row
2 REM C=a column
3 REM N=loop counter
4 REM A=what the code gave
10 CLEAR 49999
20 BORDER 0: PAPER 0: INK 7: CLS
30 PRINT "LOADING THE CODE"
40 LOAD ""CODE
50 CLS
60 PRINT AT 2,5; PAPER 2;" ";AT 16,20; PAPER 4; INK 1;" ";AT 21,31; PAPER 6; BRIGHT 1;" "
70 PRINT AT 4,0;"ROW COL ADDRESS  CODE ATTR"
80 RESTORE 500: FOR N=1 TO 5: READ R,C: POKE 50000,C: POKE 50001,R
90 PRINT AT 4+N,0;R;TAB 4;C;TAB 8;USR 50100;TAB 17;USR 50200;TAB 22;ATTR (R,C)
100 NEXT N
110 POKE 50002,0: POKE 50003,0: LET A=USR 50300
120 PRINT AT 12,0;"LD (50002),BC WITH BC=2*256+7"
130 PRINT "50002 HOLDS ";PEEK 50002;", 50003 HOLDS ";PEEK 50003
140 STOP
500 DATA 0,0,2,5,16,20,21,31,5,5
