1 REM R=a byte as port 31 would give it
2 REM K=what the routine gave back
3 REM N=counts the table
4 REM P=the port read live
5 REM B$=R as 8 bits
6 REM B=a bit's place
20 CLEAR 49999
30 LOAD ""CODE
40 BORDER 0: PAPER 0: INK 7: CLS
50 PRINT "BYTE  BITS      KEYS  MEANS"
60 RESTORE 500
70 FOR N=1 TO 11: READ R: POKE 50000,R: LET K=USR 50100
80 LET B$="": FOR B=7 TO 0 STEP -1: LET B$=B$+STR$ (INT (R/2^B)-2*INT (R/2^(B+1))): NEXT B
90 PRINT R;TAB 6;B$;TAB 16;K;TAB 21;
100 IF R>=32 THEN PRINT "IGNORED": GO TO 120
110 PRINT ("RIGHT " AND K-2*INT (K/2)=1);("LEFT " AND INT (K/2)-2*INT (K/4)=1);("FIRE" AND K>=4);("NONE" AND K=0)
120 NEXT N
130 PRINT : PRINT "NOW, PORT 31 READS ";IN 31
140 LET P=USR 50200: PRINT "AND THE ROUTINE GIVES ";P
150 STOP
500 DATA 0,1,2,3,4,8,16,17,18,32,255
